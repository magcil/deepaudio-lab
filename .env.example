# PostgreSQL
POSTGRES_USER=deepaudio
POSTGRES_PASSWORD=deepaudio
POSTGRES_DB=deepaudio

# SeaweedFS / S3
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=secret
S3_PUBLIC_URL=http://localhost:8333
DATA_BUCKET=raw-audios
CHECKPOINTS_BUCKET=checkpoints
ARTIFACTS_BUCKET=artifacts

# Backend — limits (see backend/config/limits.py)
# Per-user upload quota in bytes (10 GB)
USER_SPACE_LIMIT=10737418240
# System-wide storage cap across all users in bytes (100 GB)
TOTAL_STORAGE_LIMIT=107374182400
# Max audio segment length in seconds
MAX_SEGMENT_DURATION=10.0
MAX_EPOCHS=100
MAX_BATCH_SIZE=128
MAX_NUM_WORKERS=4
# Max in-flight (queued + running) jobs per user / system, by type, plus an overall ceiling
MAX_USER_TRAININGS=1
MAX_SYSTEM_TRAININGS=4
MAX_USER_EVALUATIONS=2
MAX_SYSTEM_EVALUATIONS=4
MAX_USER_JOBS=2
MAX_SYSTEM_JOBS=4
# Liveness heartbeat (Redis): beat interval and time-to-live in seconds
HEARTBEAT_INTERVAL_SECONDS=30
JOB_HEARTBEAT_TTL_SECONDS=180
# Reaper: how often it runs; dataset auto-deletion (off by default) + retention window
REAPER_INTERVAL_SECONDS=300
DATASET_RETENTION_ENABLED=false
DATASET_RETENTION_SECONDS=2592000

# Keycloak (backend is a token verifier only — needs the realm, no client/secret)
KEYCLOAK_REALM=deepaudiolab

# Frontend — baked into the static build at image build time
VITE_API_URL=http://localhost:8000
