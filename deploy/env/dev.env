# Dev-server install env. Same shape as local.env; override the host-facing URLs
# (S3_PUBLIC_URL, VITE_API_URL, KEYCLOAK_SERVER_URL) to point at the dev host.
ENV_FILE=deploy/env/dev.env

# PostgreSQL
POSTGRES_USER=deepaudio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deepaudio

# SeaweedFS / S3 — point S3_PUBLIC_URL at the dev host's reachable S3 endpoint
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=change-me
S3_PUBLIC_URL=http://dev-host:8333
DATA_BUCKET=raw-audios
CHECKPOINTS_BUCKET=checkpoints
ARTIFACTS_BUCKET=artifacts

# Backend limits / caps / heartbeat / reaper
USER_SPACE_LIMIT=10737418240
TOTAL_STORAGE_LIMIT=107374182400
MAX_SEGMENT_DURATION=10.0
MAX_EPOCHS=100
MAX_BATCH_SIZE=128
MAX_NUM_WORKERS=4
MAX_USER_TRAININGS=1
MAX_SYSTEM_TRAININGS=4
MAX_USER_EVALUATIONS=2
MAX_SYSTEM_EVALUATIONS=4
MAX_USER_JOBS=2
MAX_SYSTEM_JOBS=4
HEARTBEAT_INTERVAL_SECONDS=30
JOB_HEARTBEAT_TTL_SECONDS=180
REAPER_INTERVAL_SECONDS=300
DATASET_RETENTION_ENABLED=false
DATASET_RETENTION_SECONDS=2592000

# Keycloak — KEYCLOAK_SERVER_URL is for the backend (token validation);
# VITE_KEYCLOAK_URL is baked into the SPA so the browser can reach Keycloak.
KEYCLOAK_SERVER_URL=http://dev-host:8080
KEYCLOAK_REALM=deepaudiolab
KEYCLOAK_CLIENT_ID=deepaudiolab-backend
KEYCLOAK_CLIENT_SECRET=change-me

# Frontend build-time values (baked into the static bundle)
VITE_API_URL=http://dev-host:8000
VITE_KEYCLOAK_URL=http://dev-host:8080
VITE_KEYCLOAK_CLIENT_ID=deepaudiolab
