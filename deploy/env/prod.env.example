# Production install env (template). Copy to prod.env and fill in real values.
# Used only for compose-variable substitution by the STANDALONE prod compose
# (docker-compose.prod.yml) — that file sets container env explicitly, so there
# is no ENV_FILE self-pointer here.
#
#   cp deploy/env/prod.env.example deploy/env/prod.env   # then edit, keep it secret

# Public domain. App at https://${DOMAIN}, auth at https://auth.${DOMAIN},
# storage at https://storage.${DOMAIN}.
DOMAIN=deepaudio.example.com

# Email for Let's Encrypt registration / expiry notices (certbot service).
CERTBOT_EMAIL=admin@example.com

# App PostgreSQL
POSTGRES_USER=deepaudio
POSTGRES_PASSWORD=__change_me__
POSTGRES_DB=deepaudio

# Keycloak's dedicated PostgreSQL
KC_DB_USER=keycloak
KC_DB_NAME=keycloak
KC_DB_PASSWORD=__change_me__

# Keycloak admin + realm. The backend validates JWTs against the realm's public
# JWKS only, so it needs no client id/secret — just the realm name and server URL.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=__change_me__
KEYCLOAK_REALM=deepaudiolab

# SeaweedFS / S3
AWS_ACCESS_KEY_ID=__change_me__
AWS_SECRET_ACCESS_KEY=__change_me__
DATA_BUCKET=raw-audios
CHECKPOINTS_BUCKET=checkpoints
ARTIFACTS_BUCKET=artifacts

# Backend limits / caps / heartbeat / reaper. These are forwarded explicitly by
# docker-compose.prod.yml (it has no env_file), so set any you want to override;
# omitted ones use the code defaults shown.
USER_SPACE_LIMIT=10737418240
TOTAL_STORAGE_LIMIT=107374182400
MAX_SEGMENT_DURATION=10.0
MAX_EPOCHS=100
MAX_BATCH_SIZE=128
MAX_NUM_WORKERS=4
MAX_USER_TRAININGS=1
MAX_SYSTEM_TRAININGS=4
MAX_USER_EVALUATIONS=2
MAX_SYSTEM_EVALUATIONS=4
MAX_USER_JOBS=2
MAX_SYSTEM_JOBS=4
HEARTBEAT_INTERVAL_SECONDS=30
JOB_HEARTBEAT_TTL_SECONDS=180
REAPER_INTERVAL_SECONDS=300
DATASET_RETENTION_ENABLED=false
DATASET_RETENTION_SECONDS=2592000
